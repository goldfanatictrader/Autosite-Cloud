# Fastify API (all values have local-development defaults)
PORT=3001
HOST=0.0.0.0
JWT_SECRET=replace-this-with-a-long-random-secret
WEB_ORIGIN=http://localhost:3000

# PostgreSQL persistence (optional; the API falls back to memory if unavailable)
DATABASE_URL=postgres://autosite:autosite@localhost:5432/autosite

# Next.js web dashboard
NEXT_PUBLIC_API_URL=http://localhost:3001

# AI writer (optional; leave both keys blank for deterministic local output)
# OpenAI is used when both provider keys are set.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional provider model override and API base URL (for compatible gateways)
AI_MODEL=
AI_BASE_URL=

# Redis and MinIO are not used by the Phase 1 API.
